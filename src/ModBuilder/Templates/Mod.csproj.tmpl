    <Reference Include="UnityEngine.TerrainPhysicsModule"><HintPath>$(COI_ROOT)\Captain of Industry_Data\Managed\UnityEngine.TerrainPhysicsModule.dll</HintPath></Reference>
    <Reference Include="UnityEngine.UIElementsModule"><HintPath>$(COI_ROOT)\Captain of Industry_Data\Managed\UnityEngine.UIElementsModule.dll</HintPath></Reference>
    <Reference Include="UnityEngine.VideoModule"><HintPath>$(COI_ROOT)\Captain of Industry_Data\Managed\UnityEngine.VideoModule.dll</HintPath></Reference>
    <Reference Include="UnityEngine.AudioModule"><HintPath>$(COI_ROOT)\Captain of Industry_Data\Managed\UnityEngine.AudioModule.dll</HintPath></Reference>
    <Reference Include="UnityEngine.ImageConversionModule"><HintPath>$(COI_ROOT)\Captain of Industry_Data\Managed\UnityEngine.ImageConversionModule.dll</HintPath></Reference>
    <Reference Include="UnityEngine.TerrainModule"><HintPath>$(COI_ROOT)\Captain of Industry_Data\Managed\UnityEngine.TerrainModule.dll</HintPath></Reference>
    <Reference Include="UnityEngine.UI"><HintPath>$(COI_ROOT)\Captain of Industry_Data\Managed\UnityEngine.UI.dll</HintPath></Reference>
    <Reference Include="Unity.VectorGraphics"><HintPath>$(COI_ROOT)\Captain of Industry_Data\Managed\Unity.VectorGraphics.dll</HintPath></Reference>
  </ItemGroup>

  <ItemGroup>
{{ASSETBUNDLES_ITEMGROUP}}    <Assets Include="{{PACK_DIR}}\Assets\**\*" />
    <Definitions Include="{{PACK_DIR}}\Definitions\**\*" />
  </ItemGroup>

  <!-- Rasterize SVG icons to PNG before deploy. Runs ModBuilder.exe svg2png on the pack's
       Assets folder. The .svg sources stay in the repo; .png artifacts are emitted next to
       them and shipped (the .svg files themselves are EXCLUDED from the deploy/zip below).
       Always runs (no Condition on Exists — the tool tolerates missing dirs); incremental
       on a per-file basis via mtime. Errors fail the build. -->
  <Target Name="RasterizeSvgIcons" BeforeTargets="DeployToModsFolder">
    <Message Text="Rasterizing SVG icons in {{PACK_DIR}}\Assets..." Importance="high" />
    <Exec Command="&quot;{{MODBUILDER_EXE}}&quot; svg2png &quot;{{PACK_DIR}}\Assets&quot;" Condition="Exists('{{PACK_DIR}}\Assets')" />
    <!-- Pack-root thumbnail.svg (sibling of manifest.json). The directory-scan above
         only walks Assets/, so the pack-root SVG needs its own pass. -->
    <Exec Command="&quot;{{MODBUILDER_EXE}}&quot; svg2png &quot;{{PACK_DIR}}\thumbnail.svg&quot;" Condition="Exists('{{PACK_DIR}}\thumbnail.svg')" />
  </Target>

  <Target Name="DeployToModsFolder" AfterTargets="PostBuildEvent">
    <Message Text="Deploying {{DISPLAY_TITLE}} to mods folder..." Importance="high" />
    <Copy SourceFiles="{{PACK_DIR}}\manifest.json" DestinationFolder="$(COI_MODS)\{{ID}}" />
    <Copy SourceFiles="{{PACK_DIR}}\config.json" DestinationFolder="$(COI_MODS)\{{ID}}" ContinueOnError="true" />
    <!-- Pack-root thumbnail (shown by the in-game mod browser). Optional; only copied
         if present. The companion thumbnail.svg, if any, is rasterized by the
         RasterizeSvgIcons target above before deploy. -->
    <Copy SourceFiles="{{PACK_DIR}}\thumbnail.png" DestinationFolder="$(COI_MODS)\{{ID}}" Condition="Exists('{{PACK_DIR}}\thumbnail.png')" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(COI_MODS)\{{ID}}" />
    <Copy SourceFiles="$(TargetDir)$(TargetName).pdb" DestinationFolder="$(COI_MODS)\{{ID}}" Condition="'$(Configuration)' == 'Debug'" />
    <!-- Re-glob assets inside the target so PNGs newly generated by RasterizeSvgIcons
         (which ran BeforeTargets="DeployToModsFolder") are included. The static @(Assets)
         ItemGroup at the top of the file was evaluated at project load, before svg2png.
         `.svg` sources are EXCLUDED — they're build inputs, not runtime assets. The game
         loads the rasterized PNG via CustomAssetRegistrator.ResolveIconPath. -->
    <ItemGroup>
      <_DeployAssets Include="{{PACK_DIR}}\Assets\**\*" Exclude="{{PACK_DIR}}\Assets\**\*.svg" />
    </ItemGroup>
{{ASSETBUNDLES_COPY}}    <Copy SourceFiles="@(_DeployAssets)" DestinationFolder="$(COI_MODS)\{{ID}}\Assets\%(RecursiveDir)" />
    <Copy SourceFiles="@(Definitions)" DestinationFolder="$(COI_MODS)\{{ID}}\Definitions\%(RecursiveDir)" />

    <!-- Build the distribution zip such that extracting it creates a single top-level
         folder named after the mod id (the convention COI's mod manager — and most game-mod
         distribution conventions — expect). MSBuild's ZipDirectory task always zips the
         CONTENTS of the source directory at the zip root, with no wrapping folder. Workaround:
         stage the deployed mod into IntermediateOutputPath/zip-stage/{{ID}}/ and zip the
         parent (zip-stage). The zip then contains "{{ID}}/manifest.json", "{{ID}}/Assets/..."
         etc. instead of "manifest.json", "Assets/..." at the root. -->
    <RemoveDir Directories="$(IntermediateOutputPath)zip-stage" Condition="Exists('$(IntermediateOutputPath)zip-stage')" />
    <ItemGroup>
      <!-- Exclude .svg even from the zip-stage glob, defensive against stale .svg files
           that may have been deployed by an older build before the .svg exclusion above. -->
      <_ZipStageFiles Include="$(COI_MODS)\{{ID}}\**\*" Exclude="$(COI_MODS)\{{ID}}\**\*.svg" />
    </ItemGroup>
    <Copy SourceFiles="@(_ZipStageFiles)" DestinationFolder="$(IntermediateOutputPath)zip-stage\{{ID}}\%(RecursiveDir)" />
    <ZipDirectory SourceDirectory="$(IntermediateOutputPath)zip-stage" DestinationFile="$(COI_MODS)\{{ID}}_{{RAW_VERSION}}.zip" Overwrite="true" />
    <RemoveDir Directories="$(IntermediateOutputPath)zip-stage" />
  </Target>
</Project>
