@inject UndoService Undo
@implements IDisposable

<div class="side-panel-section">
    <h3>History</h3>
    <div class="history-body">
        <ul class="history-list">
            @* Chronological — oldest action at top, most recent past just above
               the Current marker. Then future (redo) entries flow downward, with
               the next redo immediately below current. Click any row to jump to
               that point in history. *@
            @{
                var undoList = Undo.UndoEntries; // top-first = most recent first
                var undoCount = undoList.Count;
            }
            @* Iterate undo stack from bottom (oldest) to top (newest past). *@
            @for (int origIdx = undoCount - 1; origIdx >= 0; origIdx--)
            {
                var entry = undoList[origIdx];
                var stepsBack = origIdx + 1;
                <li class="history-item past" @onclick="() => Undo.Jump(stepsBack)"
                    title="Undo @stepsBack step(s) — revert this action">
                    <span class="hi-step">↶</span>
                    <span class="hi-desc">@entry.Description</span>
                    <span class="hi-time">@entry.At.ToString("HH:mm:ss")</span>
                </li>
            }
            <li class="history-item current" title="Current state">
                <span class="hi-step">●</span>
                <span class="hi-desc"><b>Current</b></span>
                <span class="hi-time">@undoCount edit(s)</span>
            </li>
            @* Future actions: redo stack top-first (next redo just below current),
               so iteration order matches display order chronologically. *@
            @{
                var redoList = Undo.RedoEntries;
            }
            @for (int i = 0; i < redoList.Count; i++)
            {
                var entry = redoList[i];
                var stepsForward = i + 1;
                <li class="history-item future" @onclick="() => Undo.Jump(-stepsForward)"
                    title="Redo @stepsForward step(s) — re-apply this action">
                    <span class="hi-step">↷</span>
                    <span class="hi-desc">@entry.Description</span>
                    <span class="hi-time">@entry.At.ToString("HH:mm:ss")</span>
                </li>
            }
            @if (undoCount == 0 && redoList.Count == 0)
            {
                <li class="history-item empty muted">(no history yet)</li>
            }
        </ul>
    </div>
</div>

@code {
    protected override void OnInitialized() => Undo.OnChange += OnUndoChange;
    private async void OnUndoChange()
    {
        try { await InvokeAsync(StateHasChanged); }
        catch (Exception ex) { CrashLog.Write("HistoryPanel.OnChange", ex); }
    }
    public void Dispose() => Undo.OnChange -= OnUndoChange;
}
