<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<OutputType>Library</OutputType>
		<TargetFramework>net48</TargetFramework>
		<Configurations>Debug;Release;Debug_Pack</Configurations>
		<GenerateAssemblyInfo>true</GenerateAssemblyInfo>
		<WarningLevel>9999</WarningLevel>
		<LangVersion>7.3</LangVersion>
		<!-- Version, AssemblyVersion and AssemblyFileVersion is automatically generated from 'manifest.json' -->

		<!-- Environment or project variable 'COI_ROOT' must be set. -->
		<COI_ROOT>C:\git\Game\bin</COI_ROOT>

		<!-- Environment or project variable 'COI_MODS' must be set. -->
		<COI_MODS>$(APPDATA)\Captain of Industry - 0.8.0\Mods</COI_MODS>

		<!-- When the name of unity project is changed, the destionation folder must be adjusted -->
		<!--<UnityProjectName>ExampleMod.Unity</UnityProjectName>-->

		<!-- Require DLC -->
		<Supporter>false</Supporter>
		<TrainsDlc>false</TrainsDlc>
	</PropertyGroup>

	<PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|AnyCPU' or '$(Configuration)|$(Platform)' == 'Debug_Pack|AnyCPU' ">
		<DebugSymbols>true</DebugSymbols>
		<DebugType>portable</DebugType>
		<DefineConstants>DEBUG</DefineConstants>
		<OutputPath>bin\Debug\</OutputPath>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(Platform)' == 'Release|AnyCPU'">
		<DebugSymbols>true</DebugSymbols>
		<DebugType>portable</DebugType>
		<DefineConstants></DefineConstants>
		<Optimize>true</Optimize>
		<GenerateDocumentationFile>True</GenerateDocumentationFile>
		<OutputPath>bin\Release\</OutputPath>
	</PropertyGroup>

	<ItemGroup>
	  <ProjectReference Include="..\CustomRecipes\CustomAssets.csproj" />
	</ItemGroup>

	<ItemGroup>
		<UpToDateCheckInput Include="manifest.json">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</UpToDateCheckInput>
	</ItemGroup>

	<!-- Mod class code generator -->
	<UsingTask TaskName="GenerateCodeForMod" TaskFactory="CodeTaskFactory" AssemblyName="Microsoft.Build.Tasks.Core">

		<ParameterGroup>
			<DefaultTitle ParameterType="System.String" Required="true" />
			<Manifest ParameterType="System.String" Required="true" />
			<COIRootDir ParameterType="System.String" Required="true" />
			<COIModDir ParameterType="System.String" Required="true" />
			<ProjectFile Output="true" ParameterType="System.String" />
			<NormalizedVersion Output="true" ParameterType="System.String" />
			<AuthorName Output="true" ParameterType="System.String" />
			<DisplayTitle Output="true" ParameterType="System.String" />
			<ModId Output="true" ParameterType="System.String" />
			<Error Output="true" ParameterType="System.String" />
			<Warning Output="true" ParameterType="System.String" />

		</ParameterGroup>

		<Task>
			<Reference Include="System.Text.Json" />
			<Reference Include="System.Memory" />
			<Using Namespace="System.IO" />
			<Using Namespace="System.Text" />
			<Using Namespace="System.Text.Json" />
			<Using Namespace="System.Text.RegularExpressions" />

			<Code Type="Fragment" Language="cs">
				<![CDATA[
					Warning = "";
					
					JsonDocument doc = null;
					try {
						var json = File.ReadAllText(Manifest);
						doc = JsonDocument.Parse(json);
					}
					catch (Exception ex)
					{
						Error = "Failed to read version from manifest.json: " + ex.Message;
						NormalizedVersion = "0.0.0";
						AuthorName = "Unknown";
						return false;
					}
					try {
						var raw = doc.RootElement.GetProperty("version").GetString();
						
						// Match: major.minor.patch + optional letter
						var match = Regex.Match(raw, @"^(\d+)\.(\d+)(\.(\d+)([a-z]?))?$");
						if (!match.Success)
						{
							throw new Exception("Invalid version format: " + raw);
						}
						
						var major = match.Groups[1].Value;
						var minor = match.Groups[2].Value;
						var patch = match.Groups[4].Success ? match.Groups[4].Value : "0";
						var suffix = match.Groups[5].Value;
						
						// Convert letter to number (a=1, b=2, … z=26)
						int revision = 0;
						if (!string.IsNullOrEmpty(suffix))
						{
						  revision = char.ToLower(suffix[0]) - 'a' + 1;
						}
						
						NormalizedVersion = string.Join(".", major, minor, patch, revision);
					}
					catch (Exception ex)
					{
						Warning += "Failed to read version from manifest.json: " + ex.Message + "\n";
						NormalizedVersion = "0.0.0";
					}
					try {
						JsonElement authors;
						if (doc.RootElement.TryGetProperty("authors", out authors)
							&& authors.ValueKind == JsonValueKind.Array) {
							AuthorName = string.Join(", ", authors.EnumerateArray().Select(s => s.GetString()));
						} else {
							AuthorName = "Unknown";
						}
					}
					catch (Exception ex)
					{
						Warning += "Failed to read author from manifest.json: " + ex.Message + "\n";
						AuthorName = "Unknown";
					}
					try {
						JsonElement displayName;
						if (doc.RootElement.TryGetProperty("display_name", out displayName)) {
							DisplayTitle = displayName.GetString();
						} else {
							DisplayTitle = DefaultTitle;
						}
					}
					catch (Exception ex)
					{
						Warning = "Failed to read display_name from manifest.json: " + ex.Message;
						// keep default product name
					}
					try {
						JsonElement modId;
						if (doc.RootElement.TryGetProperty("id", out modId)) {
							ModId = modId.GetString();
						} else {
							ModId = DefaultTitle;
						}
					}
					catch (Exception ex)
					{
						Warning += "Failed to read id from manifest.json: " + ex.Message + "\n";
						// keep default product name
					}
					
					Directory.CreateDirectory("Generated\\" + ModId);
				
					// Generate a code file with mod information.
					StringBuilder cw = new StringBuilder();
					cw.AppendLine("using Mafi.Core.Mods;");
					cw.AppendLine("using CustomAssets.Data.Mod;");
					cw.AppendLine();
					cw.AppendLine("namespace CustomAssetPack;");
					cw.AppendLine();
					cw.AppendLine("public class " + ModId + " : DataOnlyMod {");
					cw.AppendLine("    public " + ModId + "(ModManifest manifest) : base(manifest) { }");
					cw.AppendLine("    public override void RegisterPrototypes(ProtoRegistrator registrator) {");
					cw.AppendLine("        new CustomAssetRegistrator().RegisterData(registrator);");
					cw.AppendLine("    }");
					cw.AppendLine("}");
					File.WriteAllText("Generated\\" + ModId + "\\" + ModId + ".cs", cw.ToString());
					
					// Generate .NET project file for compilation
					StringBuilder pw = new StringBuilder();
					pw.AppendLine("<Project Sdk=\"Microsoft.NET.Sdk\">");
					pw.AppendLine("  <PropertyGroup>");
					pw.AppendLine("    <OutputType>Library</OutputType>");
					pw.AppendLine("    <TargetFramework>net48</TargetFramework>");
					pw.AppendLine("    <Configurations>Debug;Release</Configurations>");
