					pw.AppendLine("    <COI_MODS>" + COIModDir + "</COI_MODS>");
					pw.AppendLine();
					pw.AppendLine("    <Version>" + NormalizedVersion + "</Version>");
					pw.AppendLine("    <FileVersion>" + NormalizedVersion + "</FileVersion>");
					pw.AppendLine("    <AssemblyVersion>" + NormalizedVersion + "</AssemblyVersion>");
					pw.AppendLine("    <AssemblyTitle>" + DisplayTitle + "</AssemblyTitle>");
					pw.AppendLine("    <Product>" + DisplayTitle + "</Product>");
					pw.AppendLine("    <Company>" + AuthorName + "</Company>");
					pw.AppendLine("    <Copyright>" + AuthorName + "</Copyright>");
					pw.AppendLine("  </PropertyGroup>");
					pw.AppendLine();
					pw.AppendLine("  <ItemGroup>");
					pw.AppendLine("    <ProjectReference Include=\"..\\..\\..\\CustomRecipes\\CustomAssets.csproj\" />");
