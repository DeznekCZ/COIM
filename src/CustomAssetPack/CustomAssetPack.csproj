<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<OutputType>Library</OutputType>
		<TargetFramework>net48</TargetFramework>
		<Configurations>Debug;Release;Debug_Pack</Configurations>
		<GenerateAssemblyInfo>true</GenerateAssemblyInfo>
		<WarningLevel>9999</WarningLevel>
		<LangVersion>7.3</LangVersion>
		<!-- Version, AssemblyVersion and AssemblyFileVersion are automatically generated from each pack's manifest.json by ModBuilder. -->

		<!-- Environment or project variable 'COI_ROOT' must be set. -->
		<!--<COI_ROOT>C:\git\Game\bin</COI_ROOT>-->

		<!-- Environment or project variable 'COI_MODS' must be set. -->
		<COI_MODS>$(APPDATA)\Captain of Industry\Mods</COI_MODS>

		<!-- When the name of unity project is changed, the destionation folder must be adjusted -->
		<!--<UnityProjectName>ExampleMod.Unity</UnityProjectName>-->

		<!-- Require DLC -->
		<Supporter>false</Supporter>
		<TrainsDlc>false</TrainsDlc>

		<!-- ModBuilder produces <Generated>\<id>\<id>.csproj from <Packs>\<modPack>\manifest.json. -->
		<ModBuilderProject>$(MSBuildThisFileDirectory)..\ModBuilder\ModBuilder.csproj</ModBuilderProject>
		<ModBuilderExe>$(MSBuildThisFileDirectory)..\ModBuilder\bin\Release\ModBuilder.exe</ModBuilderExe>
	</PropertyGroup>

	<PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|AnyCPU' or '$(Configuration)|$(Platform)' == 'Debug_Pack|AnyCPU' ">
		<DebugSymbols>true</DebugSymbols>
		<DebugType>portable</DebugType>
		<DefineConstants>DEBUG</DefineConstants>
		<OutputPath>bin\Debug\</OutputPath>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(Platform)' == 'Release|AnyCPU'">
		<DebugSymbols>true</DebugSymbols>
		<DebugType>portable</DebugType>
		<DefineConstants></DefineConstants>
		<Optimize>true</Optimize>
		<GenerateDocumentationFile>True</GenerateDocumentationFile>
		<OutputPath>bin\Release\</OutputPath>
	</PropertyGroup>

	<ItemGroup>
	  <ProjectReference Include="..\CustomRecipes\CustomAssets.csproj" />
	</ItemGroup>

	<ItemGroup>
		<UpToDateCheckInput Include="manifest.json">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</UpToDateCheckInput>
	</ItemGroup>

	<ProjectExtensions>
		<VisualStudio>
			<UserProperties packs_4coalliquefaction_4manifest_1json__JsonSchema="..\..\manifest.schema.json" packs_4ironrecycling_4manifest_1json__JsonSchema="..\..\manifest.schema.json" packs_4steamheating_4manifest_1json__JsonSchema="..\..\manifest.schema.json" />
		</VisualStudio>
	</ProjectExtensions>

	<ItemGroup Condition=" '$(ProjectDir)' != '*Undefined*' ">
		<AssetBundles Include="$(ProjectDir)\Packs\$(ModPack)\AssetBundles\**\*" Exclude="**\AssetBundles;**\AssetBundles.manifest" />
		<Assets Include="$(ProjectDir)\Packs\$(ModPack)\Assets\**\*" />
		<Definitions Include="$(ProjectDir)\Packs\$(ModPack)\Definitions\**\*" />
	</ItemGroup>

	<ItemGroup>
		<ModFolders Include="Packs\**\manifest.json" />
	</ItemGroup>

	<Target Name="BuildAll" AfterTargets="PostBuildEvent" Condition="'$(ModPack)' == ''">
		<Message Text="Building all packs..." Importance="high" />
		<MSBuild Projects="$(MSBuildProjectFile)" Targets="BuildPack" Properties="ModPack=%(ModFolders.RecursiveDir);Configuration=Debug;Platform=AnyCPU" />
	</Target>

	<!-- Deploys "new-pattern" packs (Batteries for now). A new-pattern pack does not
	     generate a per-pack DLL; instead it ships a copy of CustomAssets.dll alongside
	     manifest.json + data, and the pack's manifest selects the CustomAssetPack IMod
	     class via primary_mod_class_name. Per-pack Type identity comes from the
	     non_locking_dll_load assembly isolation Mafi gives free.
	     Listed pack folders are also excluded from <ModFolders> above so BuildAll
	     does not try to generate a csproj for them. -->
	<ItemGroup>
		<NewPatternPack Include="Batteries">
			<ModId>CustomAssets_Batteries</ModId>
		</NewPatternPack>
		<NewPatternPack Include="AirFiltering">
			<ModId>CustomAssets_AirFiltering</ModId>
		</NewPatternPack>
	</ItemGroup>

	<Target Name="DeployNewPatternPacks" AfterTargets="PostBuildEvent" DependsOnTargets="EnsureModBuilder" Condition="'$(ModPack)' == ''">
		<Error Condition="'$(COI_MODS)' == ''" Text="Environment or project variable 'COI_MODS' is not set." />
		<MSBuild Projects="$(MSBuildProjectFile)" Targets="DeployOneNewPatternPack"
		         Properties="NewPatternPackName=%(NewPatternPack.Identity);NewPatternPackId=%(NewPatternPack.ModId);Configuration=$(Configuration);Platform=AnyCPU" />
	</Target>

	<Target Name="DeployOneNewPatternPack" Condition="'$(NewPatternPackName)' != ''">
		<PropertyGroup>
			<_NPPackDir>$(MSBuildThisFileDirectory)Packs\$(NewPatternPackName)</_NPPackDir>
			<_NPDeployDir>$(COI_MODS)\$(NewPatternPackId)</_NPDeployDir>
			<!-- Pack-stub DLL (~5 KB), built from src/CustomAssetPack.Lib/.
			     References CustomAssets.dll at compile time; at runtime resolves
			     to the base mod's already-loaded CustomAssets.dll via the pack's
			     mod_dependencies. -->
			<_NPStubDll>$(MSBuildThisFileDirectory)..\CustomAssetPack.Lib\bin\$(Configuration)\net48\CustomAssetPack.dll</_NPStubDll>
			<_NPStubPdb>$(MSBuildThisFileDirectory)..\CustomAssetPack.Lib\bin\$(Configuration)\net48\CustomAssetPack.pdb</_NPStubPdb>
			<!-- Stale artifacts to clean up: legacy per-pack DLL from the
			     pre-CustomAssetPack pattern, and full CustomAssets.dll/.pdb
			     from the intermediate pattern that shipped the full base mod
			     copy in each pack folder. None should remain after deploy. -->
			<_NPLegacyDll>$(_NPDeployDir)\$(NewPatternPackId).dll</_NPLegacyDll>
			<_NPLegacyPdb>$(_NPDeployDir)\$(NewPatternPackId).pdb</_NPLegacyPdb>
			<_NPStaleFullDll>$(_NPDeployDir)\CustomAssets.dll</_NPStaleFullDll>
			<_NPStaleFullPdb>$(_NPDeployDir)\CustomAssets.pdb</_NPStaleFullPdb>
		</PropertyGroup>

		<Error Condition="!Exists('$(_NPStubDll)')" Text="CustomAssetPack.dll not found at $(_NPStubDll). Build CustomAssetPack.Lib.csproj first." />

		<Message Text="Deploying $(NewPatternPackName) (new pattern: $(NewPatternPackId), ships CustomAssetPack.dll stub only)" Importance="high" />

		<!-- Clean up any DLLs/PDBs from prior pattern variants so Mafi's
		     GetExportedTypes scan only sees the intended pack-stub. -->
		<Delete Files="$(_NPLegacyDll);$(_NPLegacyPdb);$(_NPStaleFullDll);$(_NPStaleFullPdb)" Condition="Exists('$(_NPLegacyDll)') Or Exists('$(_NPLegacyPdb)') Or Exists('$(_NPStaleFullDll)') Or Exists('$(_NPStaleFullPdb)')" />

		<!-- Rasterize SVGs before copying assets (same pre-deploy step as old pattern). -->
		<Exec Command="&quot;$(ModBuilderExe)&quot; svg2png &quot;$(_NPPackDir)\Assets&quot;" Condition="Exists('$(_NPPackDir)\Assets')" />
		<Exec Command="&quot;$(ModBuilderExe)&quot; svg2png &quot;$(_NPPackDir)\thumbnail.svg&quot;" Condition="Exists('$(_NPPackDir)\thumbnail.svg')" />

		<Copy SourceFiles="$(_NPPackDir)\manifest.json" DestinationFolder="$(_NPDeployDir)" />
		<Copy SourceFiles="$(_NPPackDir)\config.json" DestinationFolder="$(_NPDeployDir)" ContinueOnError="true" />
		<Copy SourceFiles="$(_NPPackDir)\thumbnail.png" DestinationFolder="$(_NPDeployDir)" Condition="Exists('$(_NPPackDir)\thumbnail.png')" />
		<Copy SourceFiles="$(_NPStubDll)" DestinationFolder="$(_NPDeployDir)" />
		<Copy SourceFiles="$(_NPStubPdb)" DestinationFolder="$(_NPDeployDir)" Condition="'$(Configuration)' == 'Debug' And Exists('$(_NPStubPdb)')" />

		<ItemGroup>
			<_NPAssets Include="$(_NPPackDir)\Assets\**\*" Exclude="$(_NPPackDir)\Assets\**\*.svg" />
			<_NPDefs Include="$(_NPPackDir)\Definitions\**\*" />
		</ItemGroup>
		<Copy SourceFiles="@(_NPAssets)" DestinationFolder="$(_NPDeployDir)\Assets\%(RecursiveDir)" />
		<Copy SourceFiles="@(_NPDefs)" DestinationFolder="$(_NPDeployDir)\Definitions\%(RecursiveDir)" />
	</Target>

	<Target Name="EnsureModBuilder">
		<MSBuild Projects="$(ModBuilderProject)" Targets="Restore;Build" Properties="Configuration=Release" Condition="!Exists('$(ModBuilderExe)')" />
		<Error Condition="!Exists('$(ModBuilderExe)')" Text="ModBuilder.exe was not produced at $(ModBuilderExe)." />
	</Target>

	<Target Name="BuildPack" DependsOnTargets="EnsureModBuilder">
		<Error Condition="'$(COI_ROOT)' == ''" Text="Environment or project variable 'COI_ROOT' is not set." />
		<Error Condition="'$(COI_MODS)' == ''" Text="Environment or project variable 'COI_MODS' is not set." />

		<PropertyGroup>
			<_PackDir>$(MSBuildThisFileDirectory)Packs\$(ModPack.TrimEnd('\'))</_PackDir>
			<_GeneratedRoot>$(MSBuildThisFileDirectory)Generated</_GeneratedRoot>
			<_LibCsproj>$(MSBuildThisFileDirectory)..\CustomRecipes\CustomAssets.csproj</_LibCsproj>
			<_CsprojOutFile>$(_GeneratedRoot)\.last-csproj-$(ModPack.TrimEnd('\')).txt</_CsprojOutFile>
			<_ModBuilderArgs>build "$(_PackDir)" --coi-root "$(COI_ROOT)" --coi-mods "$(COI_MODS)" --lib-csproj "$(_LibCsproj)" --generated-root "$(_GeneratedRoot)" --mode auto --no-build --csproj-out "$(_CsprojOutFile)"</_ModBuilderArgs>
			<_ModBuilderArgs Condition="'$(Supporter)' == 'true'">$(_ModBuilderArgs) --supporter</_ModBuilderArgs>
			<_ModBuilderArgs Condition="'$(TrainsDlc)' == 'true'">$(_ModBuilderArgs) --trains-dlc</_ModBuilderArgs>
		</PropertyGroup>

		<MakeDir Directories="$(_GeneratedRoot)" />
		<Message Text="Generating mod project for $(ModPack)..." Importance="high" />
		<Exec Command="&quot;$(ModBuilderExe)&quot; $(_ModBuilderArgs)" />

		<ReadLinesFromFile File="$(_CsprojOutFile)">
			<Output TaskParameter="Lines" PropertyName="ProjectFile" />
		</ReadLinesFromFile>
		<Error Condition="'$(ProjectFile)' == ''" Text="ModBuilder did not produce a csproj path file at $(_CsprojOutFile)." />

		<Message Text="Building package $(ModPack) at $(ProjectFile)..." Importance="high" />
		<MSBuild Projects="$(ProjectFile)" Targets="Restore" />
		<MSBuild Projects="$(ProjectFile)" Targets="Build" Properties="Configuration=Debug;Platform=AnyCPU" />
	</Target>

	<ItemGroup>
		<Compile Remove="Generated\**" />
		<Compile Remove="Packs\HydrogenGenerator\**" />
		<EmbeddedResource Remove="Generated\**" />
		<EmbeddedResource Remove="Packs\HydrogenGenerator\**" />
		<ModFolders Remove="Packs\HydrogenGenerator\**" />
		<None Remove="Generated\**" />
		<None Remove="Packs\HydrogenGenerator\**" />

		<!-- New-pattern packs: ship a copy of CustomAssets.dll inside the pack folder
		     and select the pack-entry IMod via primary_mod_class_name=CustomAssetPack.
		     No per-pack DLL is generated by ModBuilder. Deploy is handled by the
		     DeployNewPatternPacks target below — these packs are excluded from BuildAll. -->
		<Compile Remove="Packs\Batteries\**" />
		<EmbeddedResource Remove="Packs\Batteries\**" />
		<ModFolders Remove="Packs\Batteries\**" />
		<None Remove="Packs\Batteries\**" />
		<Compile Remove="Packs\AirFiltering\**" />
		<EmbeddedResource Remove="Packs\AirFiltering\**" />
		<ModFolders Remove="Packs\AirFiltering\**" />
		<None Remove="Packs\AirFiltering\**" />
	</ItemGroup>

	<ItemGroup>
	  <None Include="Generated\.gitignore" />
	</ItemGroup>
</Project>
