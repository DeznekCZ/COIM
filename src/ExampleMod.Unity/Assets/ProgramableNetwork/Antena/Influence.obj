# Define Vertices
v -1.0 0.0 -1.0  # Plane Bottom Left
v  1.0 0.0 -1.0  # Plane Bottom Right
v  1.0 0.0  1.0  # Plane Top Right
v -1.0 0.0  1.0  # Plane Top Left

# Define Texture Coordinates
vt 0.0 0.0  # Bottom Left
vt 1.0 0.0  # Bottom Right
vt 1.0 1.0  # Top Right
vt 0.0 1.0  # Top Left

# Define Faces with Texture Mapping (Plane)
f 4/1 3/2 2/3 1/4
