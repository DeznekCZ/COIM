<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net48</TargetFramework>
    <Configurations>Debug;Release;Debug_Pack;Core_Only</Configurations>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <WarningLevel>9999</WarningLevel>
    <RunPostBuildEvent>Always</RunPostBuildEvent>
    <!-- Version, AssemblyVersion and AssemblyFileVersion are automatically generated from 'manifest.json' by the ReadJsonVersion target below. -->
    <LangVersion>latest</LangVersion>
      
    <!--<COI_ROOT>C:\git\Game\bin</COI_ROOT>-->
    <COI_APPDATA>$(APPDATA)\Captain of Industry</COI_APPDATA>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|AnyCPU' or '$(Configuration)|$(Platform)' == 'Debug_Pack|AnyCPU' or '$(Configuration)|$(Platform)' == 'Core_Only|AnyCPU' ">
    <DebugSymbols>true</DebugSymbols>
    <DebugType>portable</DebugType>
    <DefineConstants>DEBUG</DefineConstants>
    <OutputPath>bin\Debug\</OutputPath>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)' == 'Release|AnyCPU'">
    <DebugSymbols>true</DebugSymbols>
    <DebugType>portable</DebugType>
    <DefineConstants></DefineConstants>
    <Optimize>true</Optimize>
    <OutputPath>bin\Release\</OutputPath>
  </PropertyGroup>

  <!-- ModBuilder's SVG rasterizer, shared into the mod DLL so the in-game
       thumbnail picker can convert a picked .svg to Thumbnail.png without a
       rebuild (ThumbnailWriter). Same sources the build-time svg2png command
       uses, so both paths produce identical output. PngToSvgTracer is left
       out — it is build-tooling only. -->
  <ItemGroup>
    <Compile Include="..\ModBuilder\Svg\SvgRenderer.cs"  Link="Svg\SvgRenderer.cs" />
    <Compile Include="..\ModBuilder\Svg\SvgPath.cs"      Link="Svg\SvgPath.cs" />
    <Compile Include="..\ModBuilder\Svg\SvgColor.cs"     Link="Svg\SvgColor.cs" />
    <Compile Include="..\ModBuilder\Svg\SvgTransform.cs" Link="Svg\SvgTransform.cs" />
  </ItemGroup>

