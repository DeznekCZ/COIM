  <!-- Version generator: reads 'version', 'authors' and 'display_name' from manifest.json
       (the standard shared with COIM_ProgramableNetwork). The raw manifest version (e.g.
       "0.3.0a") names the distribution zip; the normalized form ("0.3.0.1") feeds the
       assembly version attributes. -->
  <UsingTask TaskName="ProcessManifest" TaskFactory="CodeTaskFactory" AssemblyName="Microsoft.Build.Tasks.Core">

    <ParameterGroup>
      <Manifest ParameterType="System.String" Required="true" />
      <DefaultTitle ParameterType="System.String" Required="true" />
      <NormalizedVersion Output="true" ParameterType="System.String" />
      <ManifestVersion Output="true" ParameterType="System.String" />
      <AuthorName Output="true" ParameterType="System.String" />
      <DisplayTitle Output="true" ParameterType="System.String" />
    </ParameterGroup>

    <Task>
      <Reference Include="System.Text.Json" />
      <Reference Include="System.Memory" />
      <Using Namespace="System.IO" />
      <Using Namespace="System.Text.Json" />
      <Using Namespace="System.Text.RegularExpressions" />

      <Code Type="Fragment" Language="cs">
        <![CDATA[
          JsonDocument doc = null;
          try {
            var json = File.ReadAllText(Manifest);
            doc = JsonDocument.Parse(json);
          }
          catch (Exception ex)
          {
            Console.Error.WriteLine("Failed to read version from manifest.json: " + ex.Message);
            NormalizedVersion = "0.0.0";
            AuthorName = "Unknown";
            return false;
          }
          try {
            ManifestVersion = doc.RootElement.GetProperty("version").GetString();

            // Match: major.minor.patch + optional letter
            var match = Regex.Match(ManifestVersion, @"^(\d+)\.(\d+)(\.(\d+)([a-z]?))?$");
            if (!match.Success)
            {
              throw new Exception("Invalid version format: " + ManifestVersion);
            }

            var major = match.Groups[1].Value;
            var minor = match.Groups[2].Value;
            var patch = match.Groups[4].Success ? match.Groups[4].Value : "0";
            var suffix = match.Groups[5].Value;

            // Convert letter to number (a=1, b=2, … z=26)
            int revision = 0;
            if (!string.IsNullOrEmpty(suffix))
            {
              revision = char.ToLower(suffix[0]) - 'a' + 1;
            }

            NormalizedVersion = string.Join(".", major, minor, patch, revision);
          }
          catch (Exception ex)
          {
            Console.Error.WriteLine("Failed to read version from manifest.json: " + ex.Message);
            NormalizedVersion = "0.0.0";
          }
          try {
            JsonElement authors;
            if (doc.RootElement.TryGetProperty("authors", out authors)
              && authors.ValueKind == JsonValueKind.Array) {
              AuthorName = string.Join(", ", authors.EnumerateArray().Select(s => s.GetString()));
            } else {
              AuthorName = "Unknown";
            }
          }
          catch (Exception ex)
          {
            Console.Error.WriteLine("Failed to read author from manifest.json: " + ex.Message);
            AuthorName = "Unknown";
          }
          try {
            JsonElement displayName;
            if (doc.RootElement.TryGetProperty("display_name", out displayName)) {
              DisplayTitle = displayName.GetString();
            } else {
              DisplayTitle = DefaultTitle;
            }
          }
          catch (Exception ex)
          {
            Console.Error.WriteLine("Failed to read display_name from manifest.json: " + ex.Message);
            // keep default product name
          }
        ]]>
      </Code>
    </Task>
  </UsingTask>

  <Target Name="ReadJsonVersion" BeforeTargets="GetAssemblyVersion">
    <Error Condition="'$(COI_ROOT)' == ''" Text="Environment or project variable 'COI_ROOT' is not set." />

    <ProcessManifest Manifest="manifest.json" DefaultTitle="$(TargetName)">
      <Output TaskParameter="NormalizedVersion" PropertyName="VersionNormalized" />
      <Output TaskParameter="AuthorName" PropertyName="AuthorName" />
      <Output TaskParameter="DisplayTitle" PropertyName="DisplayTitle" />
      <Output TaskParameter="ManifestVersion" PropertyName="ManifestVersion" />
    </ProcessManifest>

    <PropertyGroup>
      <Version>$(VersionNormalized)</Version>
      <FileVersion>$(VersionNormalized)</FileVersion>
      <AssemblyVersion>$(VersionNormalized)</AssemblyVersion>
      <AssemblyTitle>$(DisplayTitle)</AssemblyTitle>
      <Product>$(DisplayTitle)</Product>
      <Company>$(AuthorName)</Company>
      <Copyright>$(AuthorName)</Copyright>
    </PropertyGroup>
  </Target>

  <Target Name="PostBuild" AfterTargets="PostBuildEvent" DependsOnTargets="ReadJsonVersion" Condition="'$(Configuration)' != 'Debug_Pack'">
    <Exec Command="mkdir &quot;$(COI_APPDATA)\Mods\$(MSBuildProjectName)&quot;" ContinueOnError="true" />
    <Exec Command="copy manifest.json &quot;$(COI_APPDATA)\Mods\$(MSBuildProjectName)&quot;" ContinueOnError="true" />
    <Exec Command="copy changelog.txt &quot;$(COI_APPDATA)\Mods\$(MSBuildProjectName)&quot;" ContinueOnError="true" />
    <!-- Mod thumbnail shown by COI's mods panel and our own pack switcher.
         thumbnail.svg is the source of truth; re-rasterize it when ModBuilder
         has been built, then deploy the PNG. The PNG is committed too, so a
         clean checkout that hasn't built ModBuilder yet still ships an icon. -->
    <Exec Command="&quot;$(MSBuildThisFileDirectory)..\ModBuilder\bin\Release\ModBuilder.exe&quot; svg2png &quot;$(MSBuildThisFileDirectory)thumbnail.svg&quot; --size 256"
          Condition="Exists('$(MSBuildThisFileDirectory)..\ModBuilder\bin\Release\ModBuilder.exe') And Exists('$(MSBuildThisFileDirectory)thumbnail.svg')"
          ContinueOnError="true" />
    <Exec Command="copy thumbnail.png &quot;$(COI_APPDATA)\Mods\$(MSBuildProjectName)&quot;" ContinueOnError="true" />
    <Exec Command="copy .\bin\Debug\net48\$(MSBuildProjectName).dll &quot;$(COI_APPDATA)\Mods\$(MSBuildProjectName)&quot;" ContinueOnError="true" />
    <Exec Command="copy .\bin\Debug\net48\$(MSBuildProjectName).pdb &quot;$(COI_APPDATA)\Mods\$(MSBuildProjectName)&quot;" ContinueOnError="true" />
    <Exec Command="robocopy .\AssetBundles &quot;$(COI_APPDATA)\Mods\$(MSBuildProjectName)\AssetBundles&quot; | echo" ContinueOnError="true" />
    <Exec Command="robocopy .\..\Recipes\Mafi &quot;$(COI_APPDATA)\Mods\$(MSBuildProjectName)\API\Mafi&quot; /S | echo" ContinueOnError="true" />
    <Exec Command="robocopy .\..\Recipes\CustomAssets &quot;$(COI_APPDATA)\Mods\$(MSBuildProjectName)\API\CustomAssets&quot; /S | echo" ContinueOnError="true" />
    <!-- Compress-Archive on a directory path (without \*) includes the directory name as root in the zip. -->
    <Exec Command="pwsh -NoProfile -Command &quot;Compress-Archive -Path '$(COI_APPDATA)\Mods\$(MSBuildProjectName)' -DestinationPath '$(COI_APPDATA)\Mods\$(MSBuildProjectName)_$(ManifestVersion).zip' -Force&quot;" />
  </Target>
</Project>
