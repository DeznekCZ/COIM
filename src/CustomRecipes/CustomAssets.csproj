    <Compile Remove="ModuleParser\Registrator\Definitions\**" />
    <EmbeddedResource Remove="AssetBundles\**" />
    <EmbeddedResource Remove="Data\Instructions\**" />
    <EmbeddedResource Remove="ModuleParser\Registrator\Definitions\**" />
    <None Remove="AssetBundles\**" />
    <None Remove="Data\Instructions\**" />
